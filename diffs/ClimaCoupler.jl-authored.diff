+            CMIPExt.gather_cells_to_polys!(poly_scratch, eg, cellv)
+            @test Array(
+                CMIPExt.gather_cells_to_polys!(to_d(poly_scratch), eg_d, to_d(cellv)),
+            ) == poly_scratch
+
+            CMIPExt.scatter_polys_to_nodes!(nodal_scratch, eg, polyv)
+            @test Array(
