+              alloc_budget
+        @test @allocated(CMIPExt.mirror_fold_partners!(cell_scratch, coastal_grid)) <
+              alloc_budget
+    end
+
+    if ClimaComms.device() isa ClimaComms.CUDADevice
+        @testset "CPU == GPU" begin
