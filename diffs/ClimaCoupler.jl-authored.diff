+            ) ≈ nodal_scratch rtol = rt
+
+            CMIPExt.scatter_polys_to_nodes_normalized!(nodal_scratch, eg, polyv, FT(1e-3))
+            @test Array(
+                CMIPExt.scatter_polys_to_nodes_normalized!(
+                    to_d(nodal_scratch),
+                    eg_d,
+                    to_d(polyv),
