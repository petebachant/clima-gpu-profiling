+                    (cloud_state.cld_cover_lw[gcol] += FT(cloudy))
+            end
+        end
+        if track_cld_cover
+            ClimaComms.@threaded device for gcol in 1:ncol
+                cloud_state.cld_cover_lw[gcol] /= n_gpt
+            end
+        end
