diff --git a/RRTMGP.jl/ext/cuda/rte_longwave_2stream.jl b/RRTMGP.jl-mod/ext/cuda/rte_longwave_2stream.jl
index 739c98c..9943798 100644
--- a/RRTMGP.jl/ext/cuda/rte_longwave_2stream.jl
+++ b/RRTMGP.jl-mod/ext/cuda/rte_longwave_2stream.jl
@@ -7,9 +7,15 @@ function rte_lw_2stream_solve!(
     as::GrayAtmosphericState,
 )
     nlay, ncol = AtmosphericStates.get_dims(as)
-    tx, bx = _configure_threadblock(ncol)
+    # 128 threads and a 168-register cap put three blocks on an SM: 12 warps,
+    # against 8 at the shipped 256/255. ncu measures 0.25 eligible warps per
+    # scheduler here, so the kernel is latency-bound with nothing to switch to;
+    # more warps is the direct lever. The 16-warp step (128 registers) was
+    # tested and lost to rematerialisation, and 12 warps is unreachable with
+    # 256-thread blocks because two of them need 2*256*168 > 65536 registers.
+    tx, bx = _configure_threadblock(128, ncol)
     args = (flux_lw, src_lw, bcs_lw, op, nlay, ncol, as)
-    @cuda always_inline = true threads = (tx) blocks = (bx) rte_lw_2stream_solve_CUDA!(
+    @cuda always_inline = true maxregs = 168 threads = (tx) blocks = (bx) rte_lw_2stream_solve_CUDA!(
         args...,
     )
     return nothing
