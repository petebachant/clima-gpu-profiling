@@ -67,10 +67,24 @@ lookup table.
 - `vmr_ref`: Reference volume mixing ratios used by the lookup table
   `(2, n_gases, n_t_ref)`.
 """
-struct ReferencePoints{RD1, RD3}
+struct ReferencePoints{RD1, RD3, FT}
     ln_p_ref::RD1
     t_ref::RD1
     vmr_ref::RD3
+    # Reciprocals of the (uniform) reference grid spacings. The gas optics
+    # divides by these once per layer per g-point in four places; holding the
+    # reciprocals turns those divides into multiplies.
+    inv_Δ_ln_p_ref::FT
+    inv_Δ_t_ref::FT
+end
+function ReferencePoints(ln_p_ref, t_ref, vmr_ref)
+    inv_Δ_ln_p_ref = inv(ln_p_ref[1] - ln_p_ref[2])
+    inv_Δ_t_ref = inv(t_ref[2] - t_ref[1])
+    return ReferencePoints{
+        typeof(ln_p_ref),
+        typeof(vmr_ref),
+        typeof(inv_Δ_t_ref),
+    }(ln_p_ref, t_ref, vmr_ref, inv_Δ_ln_p_ref, inv_Δ_t_ref)
 end
 Adapt.@adapt_structure ReferencePoints
 
