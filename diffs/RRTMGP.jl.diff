--- a/RRTMGP.jl/src/optics/optics_utils.jl
+++ b/RRTMGP.jl-mod/src/optics/optics_utils.jl
@@ -4,6 +4,14 @@
 
 Return the location of the left (lower) point of the interval in which `xi` is located in vector `x`, assuming uniform `Δx`.
 """
+# `inv_Δx` variant: the caller holds the reciprocal of the uniform spacing, so
+# this multiplies where the four-argument form divides.
+@inline function loc_lower_inv(xi, inv_Δx, n, x)
+    @inbounds xi ≤ x[1] && return 1
+    @inbounds xi >= x[n] && return n - 1
+    return @inbounds min(unsafe_trunc(Int, (xi - x[1]) * inv_Δx) + 1, n - 1)
+end
+
 @inline function loc_lower(xi, Δx, n, x)
     @inbounds xi ≤ x[1] && return 1
     @inbounds xi >= x[n] && return n - 1
