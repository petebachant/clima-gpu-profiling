+                cloudy = lw_2stream_gpt_col_both_skies!(
+                    igpt,
+                    gcol,
+                    flux,
+                    flux_lw,
+                    flux_lw_clear,
+                    band_flux,
+                    src_lw,
+                    bcs_lw,
+                    op,
+                    as,
+                    state_cache,
+                    lookup_lw,
+                    lookup_lw_cld,
+                    lookup_lw_aero,
+                    ibnd,
+                    nlev,
+                    ncol,
+                )
