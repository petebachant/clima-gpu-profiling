+    lookup_lw_precip::Union{LookUpPrecip, Nothing},
+    ngroups,
+    n_gpt,
+    round,
+)
+    wcol = threadIdx().x + (blockIdx().x - 1) * blockDim().x
+    nlev = nlay + 1
+    (; major_gpt2bnd) = lookup_lw.band_data
