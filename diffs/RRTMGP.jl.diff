+# round, because the reduction reads its slice whether it was swept or not.
+function _lw_group_sweeps_CUDA!(
+    flux::FluxLW,
+    acc::NamedTuple,
+    acc_clear::NamedTuple,
+    src_lw::SourceLW2Str,
+    bcs_lw::LwBCs,
+    op::TwoStream,
+    mask,
+    cloudy_count,
+    nlay,
+    ncol,
+    as::AtmosphericState,
