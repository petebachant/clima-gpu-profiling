+        M11 = M11, M12 = M12, M22 = M22,
+        M31 = M31, M33 = M33, M34 = M34,
+        M41 = M41, M42 = M42, M43 = M43, M44 = M44,
+        e1 = e1, e2 = e2, e4 = e4,
+    )
+end
