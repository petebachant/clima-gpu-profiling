+function crossover_diameter(v_target, v_l::F, D_min, D_max) where {F}
+    FT = float(promote_type(typeof(v_target), typeof(D_min), typeof(D_max)))
+    f(D) = v_l(D) - v_target
+    maxiters = FT === Float32 ? 8 : 10
