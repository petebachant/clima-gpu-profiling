+    D = S / max(q_min, q_icl)
+    M22 -= D
+    M42 += D
+
+    S = CM1.accretion(procs.cloud_ice_snow_accretion, mp, tps, micro, thermo)
+    D = S / max(q_min, q_icl)
+    M22 -= D
+    M42 += D
+
+    # rain frozen in icl + rai collision
