+    new_hi = ifelse(left, p_clean, hi)
+    new_f_hi = ifelse(left, f_p, f_hi)
+    new_lo = ifelse(right, p_clean, lo)
+    new_f_lo = ifelse(right, f_p, f_lo)
+
+    return (new_lo, new_f_lo, new_hi, new_f_hi)
 end
 
