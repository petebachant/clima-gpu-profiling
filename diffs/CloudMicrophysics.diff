+@inline function _narrow_bracket(shape_problem, lo, f_lo, hi, f_hi, p::Real)
+    p_ = oftype(lo, p)
+    valid = isfinite(p_) & (lo < p_ < hi)
+    p_clean = ifelse(valid, p_, lo)
+    f_p = shape_problem(p_clean)
+    valid &= isfinite(f_p)
+
