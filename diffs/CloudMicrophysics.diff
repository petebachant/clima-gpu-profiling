+        #       |v₁ − v₂| is the differential sedimentation speed,
+        #       r = √(A/π) is the effective radius from projected ice area A.
+        integrand = D_2 -> begin
+            v2 = v_ice(D_2)
+            r2 = sqrt(ice_area(state, D_2) / π)
+            K = π * (r1 + r2)^2                    # collision cross section
+            return K * abs(v1 - v2) * n_i(D_2)     # E = 1 implied
+        end
