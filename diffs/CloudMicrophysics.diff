+    D = S / max(q_min, q_rai)
+    M33 -= D
+    M43 += D
+
+    # Rain-snow collisions: one call supplies both arms and the thermal melt.
+    (; S_rai_sno, S_sno_rai, S_melt) = CM1.accretion_snow_rain(procs.rain_snow_accretion, mp, tps, micro, thermo)
